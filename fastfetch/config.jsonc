{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;190;163;199",
      "output": "38;2;210;205;215"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "\u001b[38;2;110;110;120m╭─ \u001b[38;2;190;163;199m{user-name}\u001b[38;2;110;110;120m@\u001b[38;2;190;163;199m{host-name}"
    },
    { "type": "os",      "key": "\u001b[38;2;110;110;120m│\u001b[38;2;190;163;199m  os   " },
